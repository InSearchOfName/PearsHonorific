<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>InSearchOfName</Author>
    <Name>Pear Honorific</Name>
    <Punchline>Your Pear Desktop (YouTube Music) song as an honorific.</Punchline>
    <Description>Shows the song you are playing in Pear Desktop as your Honorific title.
Requires the Honorific plugin and Pear Desktop's built-in API Server plugin.</Description>
    <RepoUrl>https://github.com/InSearchOfName/PearsHonorific</RepoUrl>
    <Tags>pear;youtube music;music;activity;honorific</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>

  <!-- DalamudPackager only zips the build output; add images/icon.png so Dalamud shows the icon from the installed plugin folder. -->
  <UsingTask TaskName="AddIconToZip" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ZipPath ParameterType="System.String" Required="true" />
      <IconPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var zip = ZipFile.Open(ZipPath, ZipArchiveMode.Update))
        {
            zip.GetEntry("images/icon.png")?.Delete();
            zip.CreateEntryFromFile(IconPath, "images/icon.png");
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="AddIconToZip" AfterTargets="DefaultDalamudPackagerRelease" Condition="'$(Configuration)' == 'Release'">
    <AddIconToZip ZipPath="$(OutputPath)$(AssemblyName)/latest.zip" IconPath="$(MSBuildProjectDirectory)/images/icon.png" />
  </Target>
</Project>
